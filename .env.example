NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=sahajjo

# Client origins (comma-separated, allows localhost and Vercel by default)
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://shahajjo-client.vercel.app

# BetterAuth JWKS verification endpoint (public keys)
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# JWT claims (must match the Next.js auth configuration)
JWT_ISSUER=sahajjo-client
JWT_AUDIENCE=sahajjo-api
