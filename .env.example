# Local development defaults
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (shared with the Next.js BetterAuth instance)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=sahajjo

# Comma separated list of allowed browser origins
CLIENT_ORIGINS=http://localhost:3000

# Public JWKS endpoint exposed by the Next.js BetterAuth JWT plugin
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Must match the JWT plugin configuration in the Next.js app
JWT_ISSUER=sahajjo-client
JWT_AUDIENCE=sahajjo-api
